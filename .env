[ ${0##*/} = dash ] && set -bV
if [ ${0##*/} = bash ]
then
    . ~/.bashrc
    . /usr/share/bash-completion/bash_completion
fi

export PS1='[$(date +%T)] $(uname -n) ${PWD##*/} \$ '

alias e=$EDITOR
alias ee=sudoedit
alias p=$PAGER

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
cp 2>&1 | grep -iq busybox && alias cp='cp -i' || alias cp='cp -iv'
mv 2>&1 | grep -iq busybox && alias mv='mv -i' || alias mv='mv -iv'
rm 2>&1 | grep -iq busybox || alias rm='rm -Iv'

if ls --version 2>&1 | grep -iq -e busybox -e gnu
then
    alias ls='ls -F --color --group-directories-first'
    alias ll='ls -ahl --group-directories-first'
else
    alias ls='ls -F'
    alias ll='ls -ahl'
fi
alias lt='ls -ahlctr'

alias g='git status'
alias ga='git add'
alias gb='git branch'
alias gbb='git branch -avv'
alias gc='git commit'
alias gco='git checkout'
alias gd='git diff'
alias ge='git send-email'
alias gf='git fetch'
alias gl='git log'
alias gll='git log --graph'
alias gp='git push'
alias gq='git pull'
alias gr='git rebase'
alias gs='git switch'

alias q=quick
alias qd='fuzz dots'

alias pb='curl -F "file=@-" https://0x0.st'
alias kiss='killall xdg-desktop-portal-wlr'
alias tlmgr="$TEXMFDIST/scripts/texlive/tlmgr.pl --usermode"
