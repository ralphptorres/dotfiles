[ ${0##*/} = dash ] && set -bV
if [ ${0##*/} = bash ]
then . ~/.bashrc
fi

export PS1='[$(date +%T)] $(uname -n) ${PWD##*/} \$ '

alias e=$EDITOR
alias ee=sudoedit
alias p=$PAGER

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
cp 2>&1 | grep -iq busybox && alias cp='cp -i' || alias cp='cp -iv'
mv 2>&1 | grep -iq busybox && alias mv='mv -i' || alias mv='mv -iv'
rm 2>&1 | grep -iq busybox || alias rm='rm -Iv'

if ls --version 2>&1 | grep -iq -e busybox -e gnu
then
    alias ls='ls -F --color --group-directories-first'
    alias ll='ls -ahl --group-directories-first'
else
    alias ls='ls -F'
    alias ll='ls -ahl'
fi
alias lt='ls -ahlctr'

alias g='git status'
alias ga='git add'
alias gb='git branch'
alias gbb='git branch -avv'
alias gc='git commit'
alias gco='git checkout'
alias gd='git diff'
alias ge='git send-email'
alias gf='git fetch'
alias gl='git log'
alias gll='git log --graph --stat'
alias gp='git push'
alias gq='git pull'
alias gr='git rebase'
alias gs='git switch'

alias q=quick
alias qd='fuzz dots'

alias pb='curl -F "file=@-" https://0x0.st'
alias kiss='killall xdg-desktop-portal-wlr'
alias tlmgr="$TEXMFDIST/scripts/texlive/tlmgr.pl --usermode"

alias ai='aichat -m claude:claude-sonnet-4-5-20250929'
alias aii='aichat -m gemini:gemini-2.5-flash'
alias aiii='aichat -m gemini:gemini-2.5-flash-lite'

# refer: https://codeberg.org/dnkl/foot/wiki#posix-sh
osc7_cd() {
    cd "$1" || return $?

    tmp="$PWD"
    encoded=""
    while [ -n "$tmp" ]
    do
        n="${tmp#?}"
        c="${tmp%"$n"}"
        case "$c" in
            [-/:_.!\'\(\)~[:alnum:]]) encoded="$encoded$c" ;;
            *) encoded="${encoded}$(printf '%%%02X' "$c")"  ;;
        esac
        tmp="$n"
        unset n c
    done

    printf "\033]7;file://%s%s\033\\" "$(uname -n)" "$encoded"
    unset tmp decoded
}
osc7_cd "$PWD"
alias cd=osc7_cd
