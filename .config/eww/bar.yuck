(defwindow bar
  :geometry (geometry
  	:x "0"
    :y "0"
    :height "100%"
    :width "57px"
    :anchor "left center")
  :exclusive true
  :monitor "Color LCD"

  (box :orientation "v"
    (box :orientation "v" :space-evenly false :valign "start"
      ""
      (for t in tags (tag :id t :symbol "${tagssym[t - 1]}"))
      ""
      (label :angle 90 :limit-width 20 :text {river.title})
    )

    (box :orientation "v" :space-evenly false :valign "end"
      (metric-b
        :label `${utilvos != "" ? "ﱝ"
          : utilvo < 20 ? "奄"
          : utilvo < 40 ? "奔"
          : ""}`
        :value {utilvo}
        :onclick `alacritty msg create-window --class float -e pulsemixer`
        :onrightclick `adjuster vol_sink =`
      )
      (metric-b
        :label `${utilvis != "" ? "" : ""}`
        :onclick `alacritty msg create-window --class float -e pulsemixer`
        :onrightclick `adjuster vol_source =`
        :resize true
        :value {utilvi}
      )
      (metric-b
        :label `${utilb > 50 ? "" : ""}`
        :value {utilb})
      (metric-b :label "" :value {utilk})
      (metric-b
        :label `${EWW_TEMPS["CORETEMP_CORE_0"] < 60 ? ""
          : EWW_TEMPS["CORETEMP_CORE_0"] < 50 ? ""
          : EWW_TEMPS["CORETEMP_CORE_0"] < 40 ? ""
          : EWW_TEMPS["CORETEMP_CORE_0"] < 30 ? ""
          :"" }`
        :resize true
        :value {EWW_TEMPS["CORETEMP_CORE_0"]}
      )
      (metric-b :label "" :value {EWW_CPU.avg})
      (metric-b :label "" :value {EWW_RAM.used_mem_perc})
      (metric-b :label "" :resize true :value {EWW_DISK["/"].used_perc})
      (metric-b
        :label `${EWW_BATTERY.BAT0.status == "Full" ? "󰚥"
          ; : EWW_BATTERY.BAT0.status == "Charging" ? ""
          : EWW_BATTERY.BAT0.status == "Charging" ? ""
          : EWW_BATTERY.BAT0.capacity < 40 ? ""
          : EWW_BATTERY.BAT0.capacity < 20 ? ""
          : "" }`
        :label1 {EWW_BATTERY.BAT0.capacity}
        :resize true
        :value {round(EWW_BATTERY["BAT0"].capacity * (100/60), 0)}
      )
      ""
      (label :text {formattime(EWW_TIME, "%a")})
      (label :class "text-big" :text {formattime(EWW_TIME, "%m%n%d%n%H%n%M")})
      ""
      (label :class "text-big" :text "🦊")
      (label :class "text-big" :text "🐧")
      ""
    )
  )
)
