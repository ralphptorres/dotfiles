(defwindow dash
  :geometry (geometry
  	:x "0"
    :y "0"
    :height "100%"
    :width "1050"
    :anchor "left center")
  :monitor '["Artist 12 pro", "LCD", 0]'
  :stacking "fg"

  (box :orientation "v" :space-evenly false 
    (box :orientation "h" :space-evenly false
      (label
        :class "text-biggest"
        :text {formattime(EWW_TIME, "%H:%M", "Singapore")}
      )
      (box :orientation "v" :valign "center"
        ""
        (label
          :class "text-big"
          :text {formattime(EWW_TIME, "%a, %b %-d", "Singapore")}
        )
        (label :class "text-big" :text {weather})
      )
    )

    (box :orientation "h"
      (label :class "tile" :text " ${stat[2]}")
      (box 
        (label :class "tile" :text "🌌")
        (label :class "tile" :text "🤖")
      )
      (box 
        (label :class "tile" :text "🦊")
        (label :class "tile" :text "🐈")
        (label :class "tile" :text "🐟")
      )
    )

    (box :orientation "h"
      (label :class "tile" :text {weather_full})
      (box :class "tile" :orientation "v"
        :style {music.artUrl != "null"
          ? "box-shadow: inset 0 0 10rem white;
            background-image: url(\"${music.artUrl}\");
            background-size: cover;
            background-position: center;"
          : ""}
        ""
        (label :class "text-bigger" :text {music.title ?: ""})
        (label :text {music.albumArtist ?: music.artist ?: ""})
        (metric :value {music-st[1] * (100000000/music.length)})
        (label :class "text-bigger" :text {music-st[0] == "Playing" ? "⏸" : "▶"})
      )
    )

    (box :orientation "h"
      (box :orientation "v"
        (label :class "tile" :text {cal})
        (label :class "tile" :text "📰 rappler\\n${news}")
      )
      (box :orientation "v"
        (label :class "tile" :text "🗓 avida\\n${cal_avida}" :xalign 0)
        (label :class "tile" :text "🗓 ralph\\n${cal_ralph}" :xalign 0)
      )
    )
  )
)
