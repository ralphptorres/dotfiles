(defvar utilb 0)
(defvar utilk 0)
(defvar utilvi 0)
(defvar utilvo 0)
(defvar utilvis "")
(defvar utilvos "")
(defvar tags "[1, 2, 3, 4, 5, 6, 7, 8, 9]")
(defvar tagssym "[1, 2, 3, 4, 5, 6, 7, 8, 9]")
; (defvar tagssym `["I", "II", "III", "IV", "V", "VI", "VII", "8", "IX"]`)
; (defvar tagssym `["!", "@", "#", "$", "%", "^", "&", "*", "("]`)
; (defvar tagssym `["𜳱", "𜳲", "𜳳", "𜳴", "𜳵", "𜳶", "𜳷", "𜳸", "𜳹"]`)
; (defvar tagssym `["🯱", "🯲", "🯳", "🯴", "🯵", "🯶", "🯷", "🯸", "🯹"]`)

(deflisten river
  :initial ""
  `ristate -w -t -u -vt`
)

(defpoll weather
  :interval "15m"
  `curl wttr.in/quezon+city?format=1 | tr -d ' +'`
)

(defpoll stat
  :interval "5s"
  `printf '["%s","%s","%s"]' \
    "$(bluetoothctl show | grep PowerState | cut -d: -f2 | tr -d ' ')" \
    "$(bluetoothctl devices Connected | grep Device | wc -l)" \
    "$(nmcli -t connection show --active | grep wlan0 | cut -d: -f1)" \
  `
  ; $(wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d' ' -f2) \
  ; $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | cut -d' ' -f2) \
  ; $(light) \
  ; $(light -s sysfs/leds/apple::kbd_backlight) \
  ; $(wpctl status | grep \\* | grep -oP '\\[vol: \\K[0-9.]+') \
)

(defwidget tag [id symbol]
  (eventbox
    :class "text-big"
    :onclick `riverctl set-focused-tags $(( 1 << (${id} - 1) ))`
    (box
      :class `tag ${id == jq(river, ".tags | to_entries[0].value[0] | tonumber")
        ? "tag-active"
      : matches(id, jq(river, ".viewstag | to_entries[0].value | unique"))
        ? "tag-occupied"
      : "tag-empty"}` {symbol}
    )
  )
)

(defwidget metric [?label value ?value2]
  (overlay :class "metric" :orientation "h"
    ; (circular-progress :clockwise false :thickness 5 :value value)
    (progress :orientation "h" :value {value2 ?: value})
    (label :class "text-sml" :text {label})
  )
)

(defwidget metric-b [value ?value1 ?label ?label1 ?resize ?onclick ?onrightclick]
  (eventbox
    :onclick {onclick}
    :onrightclick {onrightclick}
    (overlay :class "metric" :orientation "h"
      (progress :orientation "h" :value {value1 ?: value})
      (box
        ; :halign {label1 != "" ? "fill" : "center"}
        :halign "center"
        :space-evenly {label1 != "" ? true : false}
        ; :spacing 2
        (label :class `text-${resize == true ? "big" : "bigger"}` :text {label})
        (label :class "text-sml" :text {label1})
      )
    )
  )
)
