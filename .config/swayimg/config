[viewer]
# NOTE: viewer.window config transparency is broken for light background
# filed an issue at https://github.com/artemsen/swayimg/issues/351 
window = #fafef9e6
scale = fill

[list]
all = yes

[keys.viewer]
h = step_left 10
j = step_down 10
k = step_up 10
l = step_right 10
Ctrl+p = prev_file
Ctrl+n = next_file
Shift+Space = prev_file
