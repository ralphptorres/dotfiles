profile default {
    output eDP-1 enable mode 2560x1600 scale 1
}

profile huge {
    output eDP-1 mode 2560x1600 scale 2
}

profile medium {
    output eDP-1 mode 2560x1600 scale 1.25
}

profile stream {
    output eDP-1 enable mode --custom 2560x1440 scale 1
}

profile sleep {
    output * disable
}
