// refer: https://yalter.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {
            layout "us" 
    		options "caps:swapescape,shift:both_capslock,ctrl:swap_ralt_rctl"
        }

        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
    }

    warp-mouse-to-focus
    focus-follows-mouse
}

output "eDP-1" {
    scale 1
}
