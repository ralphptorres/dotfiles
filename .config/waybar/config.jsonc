[
	{
		"layer": "top",
		"output": "eDP-1",
		"position": "right",
		"width": 59,
		"spacing": 10,
		"mode": "dock",
		"reload_style_on_change": true,

		"modules-left": ["river/tags", "river/window"],
		"modules-right": ["group/util", "group/clock", "group/emoji"],

		"river/tags": {
			"hide-vacant": true,
			"tag-labels": ["I", "II", "III", "IV", "V", "VI", "VII", "8", "IX", "X"],
			"tooltip": false
		},

		"river/window": { "max-length": 30, "rotate": 90, "tooltip": false },

		"group/util": {
			"orientation": "inherit",
			"modules": [
				"group/backlight",
				"group/battery",
			]
		},

		"group/backlight": { "modules": ["custom/backlight", "backlight"] },
		"custom/backlight": { "format": "" },
		"backlight": {
			"format": "{icon}",
			"format-icons": ["⡀", "⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"],
			"tooltip": false
		},

		"group/battery": { "modules": ["battery#icon", "battery"] },
		"battery#icon": {
			"interval": 1,
			"states": { "warning": 40, "critical": 20 },
			"format": "{icon}",
			"format-icons": {
				"discharging": "",
				"charging": "",
				"full": "󰚥",
				"warning": "",
				"critical": ""
			},
			"tooltip-format": "{timeTo} ({capacity}%)"
		},
		"battery": {
			"format": "{icon}",
			"format-icons": ["⡀", "⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"],
			"tooltip": false
		},

		"group/clock": {
			"orientation": "inherit",
			"drawer": { "transition-duration": 0, "click-to-reveal": true },
			"modules": [
				"clock",
				"clock#date",
				"custom/lock",
				"custom/poweroff",
				"custom/quit",
				"custom/reboot",
				"custom/wallpaper"
			]
		},
		"clock": { "format": "{:%H\n%M}", "tooltip": false },
		"clock#date": { "format": "{:%m\n%d\n}", "tooltip": false },
		"custom/lock": {
			"format": "L",
			"tooltip-format": "lock",
			"on-click": "pkill -USR1 swayidle"
		},
		"custom/quit": {
			"format": "Q",
			"tooltip-format": "quit",
			"on-click": "riverctl exit"
		},
		"custom/poweroff": {
			"format": "P",
			"tooltip-format": "poweroff",
			"on-click": "poweroff"
		},
		"custom/reboot": {
			"format": "R",
			"tooltip-format": "reboot",
			"on-click": "reboot"
		},
		"custom/wallpaper": {
			"format": "W",
			"tooltip-format": "wallpaper",
			"on-click": "quick wall"
		},

		"group/emoji": {
			"orientation": "inherit",
			"modules": ["custom/arrow", "custom/emoji"]
		},
		"custom/arrow": { "format": "", "tooltip": false },
		"custom/emoji": { "format": "🦊\n🐧" }
	}
]
