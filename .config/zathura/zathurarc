set default-bg rgba(11,14,13,0.95) # k tees
set default-fg rgba(250,254,249,0.95) # w tix0
set font 'monospace normal 12'
set guioptions v

set adjust-open width
set first-page-column 1:1
set highlight-active-color rgba(0,164,255,0.9) # b case0
set highlight-color rgba(0,164,255,0.5)
set recolor true
set recolor-darkcolor rgba(250,254,249,0.95)
set recolor-lightcolor rgba(11,14,13,0)
set recolor-keephue true
set selection-clipboard clipboard
set synctex-editor-command "texlab inverse-search -i %{input} -l %{line}"
set window-title-basename true
set window-title-page true

map _ zoom out
map = zoom in
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map <C-d> cycle_first_column
